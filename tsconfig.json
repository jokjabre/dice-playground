{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "packages/**/*.js",
    "apps/**/*.js",
    "e2e/**/*.js",
    "tools/**/*.js",
    "tools/**/*.mjs",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "legacy/**",
    "**/vendor/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**"
  ]
}
